#!/bin/sh
# Validate the catalog (js/database.js, js/images.js) before every commit.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git commit --no-verify
#
# Note: checks the files on disk, so stage the whole file you edited.

if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY="py -3"
else
    echo "pre-commit: python3 not found, skipping catalog validation" >&2
    exit 0
fi

$PY tools/validate-catalog.py || {
    echo "pre-commit: commit blocked. Fix the errors above, or commit with --no-verify to skip." >&2
    exit 1
}
